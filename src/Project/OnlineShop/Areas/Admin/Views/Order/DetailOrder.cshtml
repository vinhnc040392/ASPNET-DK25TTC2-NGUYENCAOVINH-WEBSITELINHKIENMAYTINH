@model Model.ViewModel.OrderViewModel

@{
    ViewBag.Title = "DetailOrder";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    //decimal total = 0;
}

@section header {
    Quản Lý Đơn Hàng
}

<input type="text" style="visibility: hidden" id="idOrder" value="@Html.DisplayFor(model => model.idOrder)" />
<div>
    <h4>Màn Hình Xem Dữ Liệu</h4>
    <hr />
    <div class="row">
        <div class="col-lg-6">
            <div class="panel panel-primary">
                <div class="panel-heading" style="text-align:center">
                    Thông Tin Đơn Hàng
                </div>
                <div class="panel-body">
                    <p>Tên Khách Hàng : @Html.DisplayFor(model => model.ShipName)</p>
                    <p>Số Điện Thoại : @Html.DisplayFor(model => model.ShipMobile)</p>
                    <p>Địa Chỉ Nhận : @Html.DisplayFor(model => model.ShipAdress)</p>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="panel panel-primary">
                <div class="panel-heading" style="text-align:center">
                    Thông Tin Đơn Hàng
                </div>
                <div class="panel-body">
                    <p>Ngày Gửi Đơn : @Html.DisplayFor(model => model.CreateDate)</p>
                    <p>Emai Liên Hệ : @Html.DisplayFor(model => model.ShipEmai)</p>
                    <p>Trạng Thái : @Html.DropDownList("Status", new List<SelectListItem>
                                                                        {
                                                                        new SelectListItem{ Text = "Chưa hoàn thành", Value = "false" },
                                                                        new SelectListItem{ Text = "Hoàn thành", Value = "true" }
                                                                        }, new { onchange = "changeStatus()" })</p>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-primary">
                <div class="panel-heading" style="text-align:center">
                    Danh Sách Sản Phẩm Có Trong Đơn Hàng
                </div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Mã Sản Phẩm</th>
                                    <th>Hình Ảnh</th>
                                    <th>Tên Sản Phẩm</th>
                                    <th>Số Lượng</th>
                                    <th>Đơn Giá</th>                                    
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ListOrderDetail)
                                {
                                    //total += item.Quantity * item.Product.Price.GetValueOrDefault(0);
                                    <tr>
                                        <td style="vertical-align:middle">@item.Product.Code</td>
                                        <td style="vertical-align:middle"><img src="@item.Product.Image" width="75"/></td>
                                        <td style="vertical-align:middle">@item.Product.Name</td>
                                        <td style="vertical-align:middle">@item.Quantity Cái</td>
                                        <td style="vertical-align:middle">@item.Product.Price.GetValueOrDefault(0).ToString("N0") VND</td>                                        
                                    </tr>
                                }
                                <tr>
                                    <td colspan="4" style="text-align:right"><strong>Tổng Số Tiền Cần Thanh Toán</strong></td>
                                    <td class="label label-important" style="display:block"> <strong> @*@total.ToString("N0") VND*@ </strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div style="text-align:center;">
        <a class="btn btn-default" href="/Admin/Order/Index" style="color: #428bca;text-decoration: none;"> Hoàn Tất </a>
    </div>
    <br /><br />
</div>

<script>
    function changeStatus() {
        $.ajax({
            type: "POST",
            url: "/Order/changeStatus",
            data: JSON.stringify({ idOrder: $('#idOrder').val(), status: $('#Status').val() }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (msg) {
                alert(msg.message);
            },
            error: function (msg) {
                alert(msg.message);
            }
        });
    }
    //$(document).ready(function () {
    //    document.getElementById("Status").selectedIndex = "1";
    //});
</script>