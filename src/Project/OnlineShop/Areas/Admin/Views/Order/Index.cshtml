@model PagedList.IPagedList<Model.Data.Order>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section header {
    Quản Lý Đơn Hàng
}
<div class="row">
    <div class="col-lg-12">
        <div id="div-5" class="accordion-body collapse in body">
            <div class="form-group row">
                <div class="col-lg-4"></div>
                <div class="col-lg-5">
                    @using (Html.BeginForm("Index", "Order", FormMethod.Get))
                    {
                        <div class="form-group input-group">
                            <input type="text" class="form-control" name="searchString" value="@ViewBag.SearchString" placeholder="tìm kiếm theo mã hoặc tên sản phẩm" />
                            <span class="input-group-btn">
                                <button class="btn btn-default" type="submit"><i class="icon-search"></i></button>
                            </span>
                        </div>
                    }
                </div>
                <div class="col-lg-3"></div>
            </div>
        </div>

    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                Danh Sách Đơn Hàng
                <div style="float:right">
                    <p class="btn btn-default btn-sm" style="margin-top:-5px">
                        @Html.ActionLink("Thêm Mới", "Create")
                    </p>
                    <p class="btn btn-default btn-sm" style="margin-top:-5px">
                        @Html.ActionLink("Xuất Excel", "ExportToExcel")
                    </p>
                </div>
            </div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="dataTables-example">
                        <thead>
                            <tr>
                                <th>Mã Đơn Hàng</th>
                                <th>Tên Khách Hàng</th>
                                <th>Điện Thoại Liên Hệ</th>
                                <th>Địa Chỉ Giao Hàng</th>
                                <th>Email Liên Hệ</th>
                                <th>Ngày Gửi Đơn</th>
                                <th>Trạng Thái</th>
                                <th>Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr id="row_@item.idOrder">
                                    <td style="text-align:center">@item.idOrder</td>
                                    <td>@item.ShipName</td>
                                    <td>@item.ShipMobile</td>
                                    <td>@item.ShipAdress</td>
                                    <td>@item.ShipEmai</td>
                                    <td>@item.CreateDate</td>
                                    <td>@(item.Status.GetValueOrDefault(false) ? "Hoàn Thành" : "Chưa Hoàn Thành")</td>
                                    <td style="text-align:center"><a href="/Admin/Order/DetailOrder/@item.idOrder" class="glyphicon glyphicon-eye-open"></a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div style="float:right">
                        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, @searchString = @ViewBag.SearchString }))
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function onSuccess(result) {
        if (result.success) {
            alert(result.message);
            $('#row_' + result.id).remove();
        } else {
            alert(result.message);
        }
    }
</script>

