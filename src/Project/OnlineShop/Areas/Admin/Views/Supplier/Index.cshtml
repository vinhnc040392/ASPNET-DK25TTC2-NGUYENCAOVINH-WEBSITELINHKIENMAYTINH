@model PagedList.IPagedList<Model.Data.Supplier>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section header {
    Quản Lý Nhà Cung Cấp
}
<div class="row">
    <div class="col-lg-12">
        <div id="div-5" class="accordion-body collapse in body">
            <div class="form-group row">
                <div class="col-lg-4"></div>
                <div class="col-lg-5">
                    @using (Html.BeginForm("Index", "Supplier", FormMethod.Get))
                    {
                        <div class="form-group input-group">
                            <input type="text" class="form-control" name="searchString" value="@ViewBag.SearchString" placeholder="tìm kiếm theo mã hoặc tên nhà cung cấp" />
                            <span class="input-group-btn">
                                <button class="btn btn-default" type="submit"><i class="icon-search"></i></button>
                            </span>
                        </div>
                    }
                </div>
                <div class="col-lg-3"></div>
            </div>
        </div>

    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                Danh Sách Nhà Cung Cấp
                <div style="float:right">
                    <p class="btn btn-default btn-sm" style="margin-top:-5px">
                        @Html.ActionLink("Thêm Mới", "Create")
                    </p>
                    <p class="btn btn-default btn-sm" style="margin-top:-5px">
                        @Html.ActionLink("Xuất Excel", "ExportToExcel")
                    </p>
                </div>
            </div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="dataTables-example">
                        <thead>
                            <tr>
                                <th>Mã Nhà Cung Cấp</th>
                                <th>Tên Nhà Cung Cấp</th>
                                <th>Gmail</th>
                                <th>Logo</th>
                                <th>Điện Thoại</th>
                                <th>Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr id="row_@item.idSupplier">
                                    <td>@item.idSupplier</td>
                                    <td>@item.Name</td>
                                    <td>@item.Email</td>
                                    <td><img src="@item.Logo" style="width:100px; height:60px" /></td>                                    
                                    <td>@item.Phone</td>
                                    <td><a href="/Admin/Supplier/Detail/@item.idSupplier" class="glyphicon glyphicon-eye-open"></a> | <a href="/Admin/Supplier/Edit/@item.idSupplier" class="glyphicon glyphicon-pencil"></a> | @Ajax.ActionLink(" ", "Delete", new { @id = item.idSupplier }, new AjaxOptions { Confirm = "Bạn có muốn xóa bản ghi này không?", OnSuccess = "onSuccess" }, new { @class = "glyphicon glyphicon-trash" })</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div style="float:right">
                        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, @searchString = @ViewBag.SearchString }))
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function onSuccess(result) {
        if (result.success) {
            alert(result.message);
            $('#row_' + result.id).remove();
        } else {
            alert(result.message);
        }
    }
</script>