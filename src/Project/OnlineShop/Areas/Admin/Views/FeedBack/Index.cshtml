@model PagedList.IPagedList<Model.Data.FeedBack>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section header {
    Quản Lý FeedBack
}
<div class="row">
    <div class="col-lg-12">
        <div id="div-5" class="accordion-body collapse in body">
            <div class="form-group row">
                <div class="col-lg-4"></div>
                <div class="col-lg-5">
                    @using (Html.BeginForm("Index", "FeedBack", FormMethod.Get))
                    {
                        <div class="form-group input-group">
                            <input type="text" class="form-control" name="searchString" value="@ViewBag.SearchString" placeholder="tìm kiếm theo tên" />
                            <span class="input-group-btn">
                                <button class="btn btn-default" type="submit"><i class="icon-search"></i></button>
                            </span>
                        </div>
                    }
                </div>
                <div class="col-lg-3"></div>
            </div>
        </div>

    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                Danh Sách FeedBack
                <div style="float:right">
                    <p class="btn btn-default btn-sm" style="margin-top:-5px">
                        @Html.ActionLink("Xuất Excel", "ExportToExcel")
                    </p>
                </div>
            </div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="dataTables-example">
                        <thead>
                            <tr>
                                <th>Họ Tên</th>
                                <th>Điện Thoại</th>
                                <th>Email</th>
                                <th>Địa Chỉ</th>
                                <th>Ngày Tạo</th>
                                <th>Trạng Thái</th>
                                <th>Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr id="row_@item.idFeedBack">
                                    <td>@item.Name</td>
                                    <td>@item.Phone</td>
                                    <td>@item.Email</td>
                                    <td>@item.Address</td>
                                    <td>@item.CreateDate</td>
                                    <td>@(item.Status.GetValueOrDefault(false) ? "Đã Phản Hồi" : "Chưa Phản Hồi")</td>
                                    <td><a href="/Admin/FeedBack/Detail/@item.idFeedBack" class="glyphicon glyphicon-eye-open"></a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div style="float:right">
                        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, @searchString = @ViewBag.SearchString }))
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>