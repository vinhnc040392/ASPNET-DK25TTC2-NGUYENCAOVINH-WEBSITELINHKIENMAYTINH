@model Model.Data.User

@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}


@section header {
    Quản Lý Người Dùng
}

@using (Html.BeginForm("Create", "User", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Màn Hình Nhập Dữ Liệu</h4>
        <hr />        
        <div class="form-group">
            @Html.LabelFor(model => model.Username, htmlAttributes: new { @class = "control-label col-lg-4" })
            <div class="col-lg-4">
                @Html.EditorFor(model => model.Username, new { htmlAttributes = new { @class = "form-control", @autofocus = "autofocus" } })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Password, htmlAttributes: new { @class = "control-label col-lg-4" })
            <div class="col-lg-4">
                @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control", @type = "Password" } })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-lg-4" })
            <div class="col-lg-4">
                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Address, htmlAttributes: new { @class = "control-label col-lg-4" })
            <div class="col-lg-4">
                @Html.EditorFor(model => model.Address, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "control-label col-lg-4" })
            <div class="col-lg-4">
                @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Phone, htmlAttributes: new { @class = "control-label col-lg-4" })
            <div class="col-lg-4">
                @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "form-control", @maxlength = "11" } })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.idUserGroup, htmlAttributes: new { @class = "control-label col-lg-4" })
            <div class="col-lg-4">
                @Html.DropDownList("idUserGroup", null, htmlAttributes: new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Status, htmlAttributes: new { @class = "control-label col-lg-4" })
            <div class="col-lg-4">
                @Html.DropDownListFor(model => model.Status, (List<SelectListItem>)ViewBag.listStatus, "--- Chọn ---", new { @class = "form-control" })
            </div>
        </div>

        <div style="text-align:center;">
            <input type="submit" value="Lưu Dữ Liệu" class="btn btn-default" style="color: #428bca;text-decoration: none;" />
            <a class="btn btn-default" href="/Admin/User/Create" style="color: #428bca;text-decoration: none;" >Làm Mới</a>
            <a class="btn btn-default" href="/Admin/User/Index" style="color: #428bca;text-decoration: none;" >Quay Lại</a>
        </div>

        <div class="form-group">
            <div class="col-lg-4"></div>
            <div class="col-lg-4">
               @Html.ValidationSummary(false, "", new { @class = "text-danger", @style = "color:red" })
            </div>
        </div>
        
    </div>
}
<br /><br /><br />

