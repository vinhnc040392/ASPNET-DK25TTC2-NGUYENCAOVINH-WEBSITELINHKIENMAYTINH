@model PagedList.IPagedList<Model.Data.User>
@using PagedList.Mvc;
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section header {
    Quản Lý Người Dùng
}

@*@section jsFooter {
    <script src="/Assets/Admin/js/controller/userController.js"></script>
}*@
<div class="row">
    <div class="col-lg-12">
        <div id="div-5" class="accordion-body collapse in body">
            <div class="form-group row">
                <div class="col-lg-4"></div>
                <div class="col-lg-5">
                    @using (Html.BeginForm("Index", "User", FormMethod.Get))
                    {
                        <div class="form-group input-group">
                            <input type="text" class="form-control" name="searchString" value="@ViewBag.SearchString" placeholder="tìm kiếm theo tài khoản hoặc tên" />
                            <span class="input-group-btn">
                                <button class="btn btn-default" type="submit"><i class="icon-search"></i></button>
                            </span>
                        </div>
                    }
                </div>
                <div class="col-lg-3"></div>
            </div>
        </div>

    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                Danh Sách Tài Khoản
                <div style="float:right">
                    <p class="btn btn-default btn-sm" style="margin-top:-5px">
                        @Html.ActionLink("Thêm Mới", "Create")
                    </p>
                    <p class="btn btn-default btn-sm" style="margin-top:-5px">
                        @Html.ActionLink("Xuất Excel", "ExportToExcel")
                    </p>
                </div>
            </div>
            
            <div class="panel-body">                
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="dataTables-example">
                        <thead>
                            <tr>
                                <th>Tài Khoản</th>
                                <th>Họ Tên</th>
                                <th>Gmail</th>
                                <th>Điện Thoại</th>
                                <th>Địa Chỉ</th>
                                <th>Trạng Thái</th>
                                <th>Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr id="row_@item.idUser">
                                    <td>@item.Username</td>
                                    <td>@item.Name</td>
                                    <td>@item.Email</td>
                                    <td>@item.Phone</td>
                                    <td>@item.Address</td>
                                    <td>@(item.Status.GetValueOrDefault(false) ? "Kích Hoạt" : "Không Kích Hoạt")</td>
                                    <td><a href="/Admin/User/Detail/@item.idUser" class="glyphicon glyphicon-eye-open"></a> | <a href="/Admin/User/Edit/@item.idUser" class="glyphicon glyphicon-pencil"></a> | @Ajax.ActionLink(" ", "Delete", new { @id = item.idUser }, new AjaxOptions { Confirm = "Bạn có muốn xóa bản ghi này không?", OnSuccess = "onSuccess" }, new { @class = "glyphicon glyphicon-trash" })</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div style="float:right">
                        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, @searchString = @ViewBag.SearchString }))
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function onSuccess(result) {
        if (result.success) {
            alert(result.message);
            $('#row_' + result.id).remove();
        } else {
            alert(result.message);
        }
    }
</script>

