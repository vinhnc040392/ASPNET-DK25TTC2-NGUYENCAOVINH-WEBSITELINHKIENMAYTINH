@model PagedList.IPagedList<Model.Data.Slide>
@using PagedList.Mvc;
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section header {
    Quản Lý Hình Ảnh Slide
}
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                Danh Sách Hình Ảnh Slide
                <div style="float:right">
                    <p class="btn btn-default btn-sm" style="margin-top:-5px">
                        @Html.ActionLink("Thêm Mới", "Create")
                    </p>
                    <p class="btn btn-default btn-sm" style="margin-top:-5px">
                        @Html.ActionLink("Xuất Excel", "ExportToExcel")
                    </p>
                </div>
            </div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="dataTables-example">
                        <thead>
                            <tr>
                                <th>Hình Ảnh</th>
                                <th>Thứ Tự Hiển Thị</th>
                                <th>Trạng Thái</th>
                                <th>Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr id="row_@item.idSlide">
                                    <td><img src="@item.Image" style="width:100px; height:60px" /></td>
                                    <td>@item.DisplayOrder</td>
                                    <td>@(item.Status.GetValueOrDefault(false) ? "Kích Hoạt" : "Không Kích Hoạt")</td>
                                    <td><a href="/Admin/Slide/Detail/@item.idSlide" class="glyphicon glyphicon-eye-open"></a> | <a href="/Admin/Slide/Edit/@item.idSlide" class="glyphicon glyphicon-pencil"></a> | @Ajax.ActionLink(" ", "Delete", new { @id = item.idSlide }, new AjaxOptions { Confirm = "Bạn có muốn xóa bản ghi này không?", OnComplete = "$('#row_" + @item.idSlide + "').remove()", HttpMethod = "Delete" }, new { @class = "glyphicon glyphicon-trash" })</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div style="float:right">
                        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
