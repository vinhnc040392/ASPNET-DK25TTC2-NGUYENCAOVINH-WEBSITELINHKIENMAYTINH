@model Model.Data.Slide

@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section header {
    Quản Lý Hình Ảnh Slide
}

@using (Html.BeginForm("Create", "Slide", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Màn Hình Nhập Dữ Liệu</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.Image, htmlAttributes: new { @class = "control-label col-lg-4" })
            <div class="col-lg-4">
                @Html.EditorFor(model => model.Image, new { htmlAttributes = new { @class = "form-control", @id = "txtImage" }, id = "txtImage" })
                @Html.ValidationMessageFor(model => model.Image, "", new { @class = "text-danger" })
            </div>
            <div class="col-lg-3">
                <input type="button" id="Browse" value="Select Image" class="btn btn-default" />
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.DisplayOrder, htmlAttributes: new { @class = "control-label col-lg-4" })
            <div class="col-lg-4">
                @Html.EditorFor(model => model.DisplayOrder, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.DisplayOrder, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Status, htmlAttributes: new { @class = "control-label col-lg-4" })
            <div class="col-lg-4">
                @Html.DropDownListFor(model => model.Status, (List<SelectListItem>)ViewBag.listStatus, "--- Chọn ---", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
            </div>
        </div>

        <div style="text-align:center;">
            <input type="submit" value="Lưu Dữ Liệu" class="btn btn-default" style="color: #428bca;text-decoration: none;" />
            <a class="btn btn-default" href="/Admin/Slide/Create" style="color: #428bca;text-decoration: none;">Làm Mới</a>
            <a class="btn btn-default" href="/Admin/Slide/Index" style="color: #428bca;text-decoration: none;">Quay Lại</a>
        </div>
    </div>
}
<br /><br /><br />
@section jsFooter
{
    <script>
        $('#Browse').on('click', function (e) {
            e.preventDefault();
            var finder = new CKFinder();
            finder.selectActionFunction = function (url) {
                $('#txtImage').val(url);
            };
            finder.popup();
        });
    </script>
}


