@model Model.Data.Category

@{
    ViewBag.Title = "Detail";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section header {
    Quản Lý Danh Mục Sản Phẩm
}

<div>
    <h4>Màn Hình Xem Dữ Liệu</h4>
    <hr />
    <div class="row">
        <div class="col-lg-2"></div>
        <div class="col-lg-8">
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table">
                        <tr>
                            <td>@Html.DisplayNameFor(model => model.Name)</td>
                            <td>@Html.DisplayFor(model => model.Name)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.MetaTitle)</td>
                            <td>@Html.DisplayFor(model => model.MetaTitle)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.ParenId)</td>
                            <td>@Html.DisplayFor(model => model.ParenId)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.idUser)</td>
                            <td>@Html.DisplayFor(model => model.User.Name)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.DisplayOrder)</td>
                            <td>@Html.DisplayFor(model => model.DisplayOrder)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.CreateDate)</td>
                            <td>@Html.DisplayFor(model => model.CreateDate)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.Status)</td>
                            <td>@Html.DisplayFor(model => model.Status)</td>
                        </tr>
                        <tr>
                            <td colspan="2" style="text-align:center">
                                <p class="btn btn-default">@Html.ActionLink("Sửa", "Edit", new { id = Model.idCategories })</p>
                                <a class="btn btn-default" href="/Admin/Category/Index" style="color: #428bca;text-decoration: none;">Quay Lại</a>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-2"></div>
    </div>
</div>
