@model Model.Data.Product

@{
    ViewBag.Title = "Detail";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section header {
    Quản Lý Sản Phẩm
}

<div>
    <h4>Màn Hình Xem Dữ Liệu</h4>
    <hr />
    <div class="row">
        <div class="col-lg-3" style="text-align:center">
            <img src="@Html.DisplayFor(model => model.Image)" alt="" id="picture" width="260">            
        </div>
        <div class="col-lg-1"></div>
        <div class="col-lg-8">
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table">
                        <tr>
                            <td>@Html.DisplayNameFor(model => model.Name)</td>
                            <td>@Html.DisplayFor(model => model.Name)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.MetaTitle)</td>
                            <td>@Html.DisplayFor(model => model.MetaTitle)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.Code)</td>
                            <td>@Html.DisplayFor(model => model.Code)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.Price)</td>
                            <td>@Html.DisplayFor(model => model.Price)$</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.Discount)</td>
                            <td>@Html.DisplayFor(model => model.Discount)$</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.Warranty)</td>
                            <td>@Html.DisplayFor(model => model.Warranty) Năm</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.Quantity)</td>
                            <td>@Html.DisplayFor(model => model.Quantity)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.Special)</td>
                            <td>@Html.DisplayFor(model => model.Special)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.Views)</td>
                            <td>@Html.DisplayFor(model => model.Views)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.idCategories)</td>
                            <td>@Html.DisplayFor(model => model.Category.Name)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.idSupplier)</td>
                            <td>@Html.DisplayFor(model => model.Supplier.Name)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.idUser)</td>
                            <td>@Html.DisplayFor(model => model.User.Name)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.CreateDate)</td>
                            <td>@Html.DisplayFor(model => model.CreateDate)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.Available)</td>
                            <td>@Html.DisplayFor(model => model.Available)</td>
                        </tr>

                        <tr>
                            <td>@Html.DisplayNameFor(model => model.Status)</td>
                            <td>@Html.DisplayFor(model => model.Status)</td>
                        </tr>

                        <tr>
                            <td colspan="2" style="text-align:center">
                                <p class="btn btn-default">@Html.ActionLink("Sửa", "Edit", new { id = Model.idProduct })</p>
                                <a class="btn btn-default" href="/Admin/Product/Index" style="color: #428bca;text-decoration: none;">Quay Lại</a>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
