@model OnlineShop.Models.LoginModel

@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row">
        <!-- Sidebar ================================================== -->
        <div id="sidebar" class="span3">
            <div class="well well-small">
                @{ Html.RenderAction("HeaderCart", "Home");}
            </div>
            <ul id="sideManu" class="nav nav-tabs nav-stacked">
                @{ Html.RenderAction("ProductCategory", "ProductHome");}
            </ul>
            <br />
            <div class="thumbnail">
                <video controls="controls" style="width:100%; height:200px">
                    <source src="/Assets/Client/images/videoquangcao/ReviewCase%20gamingDucatiMonster.mp4" type="video/mp4" />
                </video>
            </div>
            <br />
            <div class="thumbnail">
                <img src="/Assets/Client/themes/images/products/kindle.png" title="Bootshop New Kindel" alt="Bootshop Kindel">
                <div class="caption">
                    <h5>Kindle</h5>
                    <h4 style="text-align:center"><a class="btn" href="product_details.html"> <i class="icon-zoom-in"></i></a> <a class="btn" href="#">Cho Vào <i class="icon-shopping-cart"></i></a> <a class="btn btn-primary" href="#">$222.00</a></h4>
                </div>
            </div><br />
            <div class="thumbnail">
                <img src="/Assets/Client/themes/images/payment_methods.png" title="Bootshop Payment Methods" alt="Payments Methods">
                <div class="caption">
                    <h5>Payment Methods</h5>
                </div>
            </div>
        </div>
        <!-- Sidebar end=============================================== -->
        <div class="span9">
            <ul class="breadcrumb">
                <li><a href="/">Trang Chủ</a> <span class="divider">/</span></li>
                <li class="active">Đăng Nhập Thành Viên</li>
            </ul>
            <h3>Đăng Nhập</h3>
            <div class="well">
                @using (Html.BeginForm("Login", "UserHome", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        <div class="control-group">
                            @Html.LabelFor(model => model.Username, htmlAttributes: new { @class = "control-label col-lg-4" })
                            <div class="controls">
                                @Html.EditorFor(model => model.Username, new { htmlAttributes = new { @class = "form-control", @autofocus = "autofocus" } })
                            </div>
                        </div>

                        <div class="control-group">
                            @Html.LabelFor(model => model.Password, htmlAttributes: new { @class = "control-label col-lg-4" })
                            <div class="controls">
                                @Html.PasswordFor(model => model.Password, new { htmlAttributes = new { @class = "form-control" } })
                            </div>
                        </div>

                        <div class="control-group">
                            <div class="col-md-offset-2 controls">
                                <input type="submit" value="Đăng Nhập" class="btn btn-default" />
                                <a href="/dang-ky" class="btn btn-default">Đăng Ký</a>
                                <br /><br />
                                @Html.ValidationSummary(false, "", new { @style = "color:red;" })
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
