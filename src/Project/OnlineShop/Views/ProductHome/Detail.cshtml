@model Model.Data.Product
@{
    ViewBag.Title = "Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var category = (Model.Data.Category)ViewBag.Category;
    var relatedProducts = (List<Model.Data.Product>)ViewBag.RelatedProducts;
}

<div class="container">
    <div class="row">
        <!-- Sidebar ================================================== -->
        <div id="sidebar" class="span3">
            <div class="well well-small">
                @{ Html.RenderAction("HeaderCart", "Home");}
            </div>
            <ul id="sideManu" class="nav nav-tabs nav-stacked">
                @{ Html.RenderAction("ProductCategory", "ProductHome");}
            </ul>
            <br />
            <div class="thumbnail">
                <video controls="controls" style="width:100%; height:200px">
                    <source src="/Assets/Client/images/videoquangcao/ReviewCase%20gamingDucatiMonster.mp4" type="video/mp4" />
                </video>
            </div>
            <br />
            <div class="thumbnail">
                <img src="/Assets/Client/themes/images/products/kindle.png" title="Bootshop New Kindel" alt="Bootshop Kindel">
                <div class="caption">
                    <h5>Kindle</h5>
                    <h4 style="text-align:center"><a class="btn" href="product_details.html"> <i class="icon-zoom-in"></i></a> <a class="btn" href="#">Add to <i class="icon-shopping-cart"></i></a> <a class="btn btn-primary" href="#">$222.00</a></h4>
                </div>
            </div><br />
            <div class="thumbnail">
                <img src="/Assets/Client/themes/images/payment_methods.png" title="Bootshop Payment Methods" alt="Payments Methods">
                <div class="caption">
                    <h5>Payment Methods</h5>
                </div>
            </div>
        </div>
        <!-- Sidebar end=============================================== -->
        <div class="span9">
            <ul class="breadcrumb">
                <li><a href="/">Trang Chủ</a> <span class="divider">/</span></li>
                <li><a href="/san-pham/@category.MetaTitle-@category.idCategories">@category.Name</a> <span class="divider">/</span></li>
                <li class="active">@Model.Name</li>
            </ul>
            <div class="row">
                <div id="gallery" class="span3">
                    <a href="@Model.Image" title="@Model.Name">
                        <img src="@Model.Image" style="width:100%" alt="@Model.Name" />
                    </a>

                    <div class="btn-toolbar">
                        <div class="btn-group">
                            <span class="btn"><i class="icon-envelope"></i></span>
                            <span class="btn"><i class="icon-print"></i></span>
                            <span class="btn"><i class="icon-zoom-in"></i></span>
                            <span class="btn"><i class="icon-star"></i></span>
                            <span class="btn"><i class="icon-thumbs-up"></i></span>
                            <span class="btn"><i class="icon-thumbs-down"></i></span>
                        </div>
                    </div>
                </div>
                <div class="span6">
                    <h3>@Model.Name</h3>
                    <small style="color:#db0006; font-family:Roboto Condensed; font-size:15px">Mã SP : @Model.Code</small>
                    <small style="color:#db0006; font-family:Roboto Condensed; font-size:15px; float:right">Số Lượng : @Model.Quantity Sản Phẩm</small>
                    <hr class="soft" />
                    <form class="form-horizontal qtyFrm">
                        <div class="control-group">
                            <label class="control-label"><span>Đơn Giá : @(Model.Price.HasValue ? Model.Price.Value.ToString("N0") : "Liên Hệ")$</span></label>
                            <div class="controls">
                                <label class="control-label"><span>Lượt Xem : @Model.Views</span></label>
                                <a href="/them-gio-hang?productId=@Model.idProduct&quantity=1" class="btn btn-large btn-primary pull-right"> Cho Vào <i class="icon-shopping-cart"></i></a>
                            </div>
                        </div>
                    </form>

                    <hr class="soft" />
                    <h4>Mô Tả Sản Phẩm</h4>
                    <p>@Html.Raw(Model.Description)</p>
                    <a class="btn btn-small pull-right" href="#detail">Chi Tiết</a>
                    <br class="clr" />
                    <a href="#" name="detail"></a>
                    <hr class="soft" />
                </div>

                <div class="span9">
                    <ul id="productDetail" class="nav nav-tabs">
                        <li class="active"><a href="#home" data-toggle="tab">Mô Tả Chi Tiết</a></li>
                        <li><a href="#profile" data-toggle="tab">Sản Phẩm Liên Quan</a></li>
                    </ul>
                    <div id="myTabContent" class="tab-content">
                        <div class="tab-pane fade active in" id="home">
                            <h4>Thông Tin Chi Tiết Sản Phẩm</h4>
                            @Html.Raw(Model.Detail)
                        </div>
                        <div class="tab-pane fade" id="profile">
                            <div id="myTab" class="pull-right">
                                <a href="#listView" data-toggle="tab"><span class="btn btn-large"><i class="icon-list"></i></span></a>
                                <a href="#blockView" data-toggle="tab"><span class="btn btn-large btn-primary"><i class="icon-th-large"></i></span></a>
                            </div>
                            <br class="clr" />
                            <hr class="soft" />
                            <div class="tab-content">
                                <div class="tab-pane" id="listView">
                                    @foreach (var item in relatedProducts)
                                    {
                                        var url = "/chi-tiet/" + item.MetaTitle + "-" + item.idProduct;
                                        <div class="row">
                                            <div class="span2">
                                                <img src="@item.Image" alt="@item.Name" />
                                            </div>
                                            <div class="span4">
                                                <h4>@item.Name</h4>
                                                <hr class="soft" />
                                                <p>@Html.Raw(item.Description)</p>
                                                <a class="btn btn-small pull-right" href="@url">Xem Chi Tiết</a>
                                                <br class="clr" />
                                            </div>
                                            <div class="span3 alignR">
                                                <form class="form-horizontal qtyFrm">
                                                    <h3>@(item.Price.HasValue ? item.Price.Value.ToString("N0") : "Liên Hệ")$</h3><br />
                                                    <div class="btn-group">
                                                        <a href="/them-gio-hang?productId=@item.idProduct&quantity=1" class="btn btn-large btn-primary"> Cho Vào <i class="icon-shopping-cart"></i></a>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                        <hr class="soft" />
                                    }
                                </div>
                                <div class="tab-pane active" id="blockView">
                                    <ul class="thumbnails">
                                        @foreach (var item in relatedProducts)
                                        {
                                            var url = "/chi-tiet/" + item.MetaTitle + "-" + item.idProduct;
                                            <li class="span3">
                                                <div class="thumbnail">
                                                    <a href="@url"><img src="@item.Image" alt="@item.Name" style="width:160px; height:160px" /></a>
                                                    <div class="caption">
                                                        <h5>@item.Name</h5>
                                                        <h4 style="text-align:center"><a class="btn" href="@url"> <i class="icon-zoom-in"></i></a> <a class="btn" href="/them-gio-hang?productId=@item.idProduct&quantity=1">Cho Vào <i class="icon-shopping-cart"></i></a> <a class="btn btn-primary">@(Model.Price.HasValue ? Model.Price.Value.ToString("N0") : "Liên Hệ")$</a></h4>
                                                    </div>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                    <hr class="soft" />
                                </div>
                            </div>
                            <br class="clr">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
