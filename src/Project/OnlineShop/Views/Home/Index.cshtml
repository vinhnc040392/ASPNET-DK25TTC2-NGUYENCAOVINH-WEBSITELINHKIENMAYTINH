
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var slides = (List<Model.Data.Slide>)ViewBag.slides;
    var listNewProducts = (List<Model.Data.Product>)ViewBag.NewProducts;
    var listFeatureProducts1 = (List<Model.Data.Product>)ViewBag.ListFeatureProduct1;
    var listFeatureProducts2 = (List<Model.Data.Product>)ViewBag.ListFeatureProduct2;
    var listFeatureProducts3 = (List<Model.Data.Product>)ViewBag.ListFeatureProduct3;
}

@section slide {
    <div id="myCarousel" class="carousel slide">
        <div class="carousel-inner">
            <div class="item active">
                <div class="container">
                    <a><img style="width:100%; height:340px" src="/Assets/Client/themes/images/carousel/banner_92c8c96e.jpg" alt="special offers" /></a>
                </div><br /><br /><br />
            </div>

            @foreach (var item in slides)
            {
                <div class="item">
                    <div class="container">
                        <a><img style="width:100%; height:340px" src="@item.Image" alt="" /></a>
                    </div><br /><br /><br />
                </div>
            }
        </div>
        <a class="left carousel-control" href="#myCarousel" data-slide="prev">&lsaquo;</a>
        <a class="right carousel-control" href="#myCarousel" data-slide="next">&rsaquo;</a>
    </div>

}


<div class="container">
    <div class="row">
        <!-- Sidebar ================================================== -->
        <div id="sidebar" class="span3">
            <div class="well well-small">
                @{ Html.RenderAction("HeaderCart", "Home");}
            </div>
            <ul id="sideManu" class="nav nav-tabs nav-stacked">
                @{ Html.RenderAction("ProductCategory", "ProductHome");}
            </ul>
            <br />
            <div class="thumbnail">
                <img src="/Assets/Client/themes/images/products/panasonic.jpg" alt="Bootshop panasonoc New camera" />
                <div class="caption">
                    <h5>Panasonic</h5>
                    <h4 style="text-align:center"><a class="btn" href="product_details.html"> <i class="icon-zoom-in"></i></a> <a class="btn" href="#">Add to <i class="icon-shopping-cart"></i></a> <a class="btn btn-primary" href="#">$222.00</a></h4>
                </div>
            </div><br />
            <div class="thumbnail">
                <img src="/Assets/Client/themes/images/products/kindle.png" title="Bootshop New Kindel" alt="Bootshop Kindel">
                <div class="caption">
                    <h5>Kindle</h5>
                    <h4 style="text-align:center"><a class="btn" href="product_details.html"> <i class="icon-zoom-in"></i></a> <a class="btn" href="#">Add to <i class="icon-shopping-cart"></i></a> <a class="btn btn-primary" href="#">$222.00</a></h4>
                </div>
            </div><br />
            <div class="thumbnail">
                <img src="/Assets/Client/themes/images/payment_methods.png" title="Bootshop Payment Methods" alt="Payments Methods">
                <div class="caption">
                    <h5>Payment Methods</h5>
                </div>
            </div>
        </div>
        <!-- Sidebar end=============================================== -->
        <div class="span9">
            <div class="well well-small">
                <h4>Sản Phẩm Hot<small class="pull-right">200+ sản phẩm mới</small></h4>
                <div class="row-fluid">
                    <div id="featured" class="carousel slide">
                        <div class="carousel-inner">
                            <div class="item active">
                                <ul class="thumbnails">
                                    @foreach (var item in listFeatureProducts1)
                                    {
                                        var url = "/chi-tiet/" + item.MetaTitle + "-" + item.idProduct;
                                        <li class="span3">
                                            <div class="thumbnail">
                                                <i class="tag"></i>
                                                <a href="@url"><img src="@item.Image" alt="@item.Name" style="width:160px; height:160px"></a>
                                                <div class="caption">
                                                    <h4><a class="btn" href="@url">Xem</a> <span class="pull-right">@(item.Price.HasValue ? item.Price.Value.ToString("N0") : "Liên Hệ")$</span></h4>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                            <div class="item">
                                <ul class="thumbnails">
                                    @foreach (var item in listFeatureProducts2)
                                    {
                                        var url = "/chi-tiet/" + item.MetaTitle + "-" + item.idProduct;
                                        <li class="span3">
                                            <div class="thumbnail">
                                                <i class="tag"></i>
                                                <a href="@url"><img src="@item.Image" alt="@item.Name" style="width:160px; height:160px"></a>
                                                <div class="caption">
                                                    <h4><a class="btn" href="@url">Xem</a> <span class="pull-right">@(item.Price.HasValue ? item.Price.Value.ToString("N0") : "Liên Hệ")$</span></h4>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                        <a class="left carousel-control" href="#featured" data-slide="prev">‹</a>
                        <a class="right carousel-control" href="#featured" data-slide="next">›</a>
                    </div>
                </div>
            </div>
            <h4>Sản Phẩm Mới</h4>
            <ul class="thumbnails">
                @foreach (var item in listNewProducts)
                {
                    var url = "/chi-tiet/" + item.MetaTitle + "-" + item.idProduct;
                    <li class="span3">
                        <div class="thumbnail">
                            <a href="@url"><img src="@item.Image" alt="@item.Name" style="width:160px; height:160px" /></a>
                            <div class="caption">
                                <h5>@item.Name</h5>
                                <h4 style="text-align:center"><a class="btn" href="@url"> <i class="icon-zoom-in"></i></a> <a class="btn" href="/them-gio-hang?productId=@item.idProduct&quantity=1"><i class="icon-shopping-cart"></i></a> <a class="btn btn-primary">@(item.Price.HasValue ? item.Price.Value.ToString("N0") : "Liên Hệ")$</a></h4>
                            </div>
                        </div>
                    </li>
                }
            </ul>

        </div>
    </div>
</div>
