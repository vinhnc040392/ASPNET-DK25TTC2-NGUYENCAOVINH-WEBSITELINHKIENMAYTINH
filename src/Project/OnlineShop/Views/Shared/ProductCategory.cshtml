@model List<Model.Data.Category>

<!-- menu va menu da cap -->
@foreach (var item in Model.Where(x => x.ParenId == null))
{
    var child = Model.Where(x => x.ParenId == item.idCategories);
    //var parentClass = child.Count()>0?;
    <li class="subMenu">
        <a href="/san-pham/@item.MetaTitle-@item.idCategories">@item.Name</a>
        @if (child.Count() > 0)
        {
            <ul style="display:none">
                @foreach (var childItem in child)
                {
                    <li>
                        <a href="/san-pham/@childItem.MetaTitle-@childItem.idCategories"><i class="icon-chevron-right"></i>@childItem.Name</a>
                    </li>
                }
            </ul>
        }
    </li>
}
